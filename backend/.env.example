# Fast development defaults. Set DEVELOPMENT_MODE=False to train every review.
DEVELOPMENT_MODE=True
DEV_TRAIN_SAMPLES=5000
DEV_TEST_SAMPLES=1000
DEV_EPOCHS=3
FULL_EPOCHS=5
BATCH_SIZE=128
REVIEWSENSE_SEED=42

